---
import { ScrollArea } from "@/components/starwind/scroll-area"
import { cn, getHeadingMargin } from "@/lib/utils"
import type { MarkdownHeading } from "astro"
import { Icon } from "astro-icon/components"

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
---

{
  headings && headings.length > 0 && (
    <div id="mobile-toc-container" class="w-full xl:hidden">
      <details class="group">
        <summary class="flex w-full cursor-pointer items-center justify-between">
          <div class="mx-auto flex w-full max-w-3xl items-center px-4 py-3">
            <div class="relative mr-2 size-4">
              <svg class="h-4 w-4" viewBox="0 0 24 24">
                <circle
                  class="text-primary/20"
                  cx="12"
                  cy="12"
                  r="10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle
                  id="mobile-toc-progress-circle"
                  class="text-primary"
                  cx="12"
                  cy="12"
                  r="10"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-dasharray="62.83"
                  stroke-dashoffset="62.83"
                  transform="rotate(-90 12 12)"
                />
              </svg>
            </div>
            <span
              id="mobile-toc-current-section"
              class="flex-grow truncate text-sm text-muted-foreground"
            >
              Overview
            </span>
            <span class="ml-2 text-muted-foreground">
              <Icon
                name="lucide:chevron-down"
                class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
              />
            </span>
          </div>
        </summary>

        <ScrollArea class="mx-auto max-w-3xl" data-toc-header-scroll>
          <div class="max-h-[30vh]">
            <ul
              class="flex list-none flex-col gap-y-2 px-4 pb-4"
              id="mobile-table-of-contents"
            >
              {headings.map((heading) => (
                <li
                  class={cn(
                    "px-4 text-sm",
                    getHeadingMargin(heading.depth),
                    "text-foreground/60"
                  )}
                >
                  <a
                    href={`#${heading.slug}`}
                    class="mobile-toc-item underline decoration-transparent underline-offset-[3px] transition-colors duration-200 hover:decoration-inherit"
                    data-heading-id={heading.slug}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </ScrollArea>
      </details>
    </div>
  )
}

<script>
  import {
    initTOCObserver,
    subscribeToVisibleHeadings,
    subscribeToScrollProgress,
    scrollToActiveItem,
    updateScrollMask,
  } from "@/lib/toc-observer"

  const PROGRESS_CIRCLE_RADIUS = 10
  const PROGRESS_CIRCLE_CIRCUMFERENCE = 2 * Math.PI * PROGRESS_CIRCLE_RADIUS

  function initHeader() {
    const container = document.getElementById("mobile-toc-container")
    if (!container) return

    const progressCircle = document.getElementById(
      "mobile-toc-progress-circle"
    )
    const currentSectionText = document.getElementById(
      "mobile-toc-current-section"
    )
    const detailsElement = container.querySelector("details")
    const listElement = document.getElementById("mobile-table-of-contents")
    const scrollArea = container.querySelector(
      "[data-slot='scroll-area-viewport'], [data-sw-scroll-area-viewport], [data-radix-scroll-area-viewport]"
    ) as HTMLElement | null

    if (progressCircle) {
      progressCircle.style.strokeDasharray =
        PROGRESS_CIRCLE_CIRCUMFERENCE.toString()
      progressCircle.style.strokeDashoffset =
        PROGRESS_CIRCLE_CIRCUMFERENCE.toString()
    }

    const items = listElement?.querySelectorAll<HTMLElement>(".mobile-toc-item")
    items?.forEach((item) => {
      item.addEventListener("click", () => {
        if (detailsElement) detailsElement.open = false
      })
    })

    const updateMask = () => {
      if (scrollArea) updateScrollMask(scrollArea, scrollArea)
    }

    scrollArea?.addEventListener("scroll", updateMask, { passive: true })
    const handleDetailsToggle = () => {
      if (detailsElement?.open) setTimeout(updateMask, 100)
    }
    detailsElement?.addEventListener("toggle", handleDetailsToggle)

    const unsubProgress = subscribeToScrollProgress((progress) => {
      if (progressCircle) {
        progressCircle.style.strokeDashoffset = (
          PROGRESS_CIRCLE_CIRCUMFERENCE *
          (1 - progress)
        ).toString()
      }
    })

    const unsubHeadings = subscribeToVisibleHeadings(
      (activeIds, headingMap) => {
        items?.forEach((item) => {
          const id = item.dataset.headingId
          if (id && activeIds.includes(id)) {
            item.classList.add("text-foreground")
          } else {
            item.classList.remove("text-foreground")
          }
        })

        if (currentSectionText) {
          const firstHeadingId = activeIds[0]
          currentSectionText.textContent =
            (firstHeadingId && headingMap.get(firstHeadingId)) || "Overview"
        }

        if (scrollArea && activeIds.length > 0) {
          const firstActive = listElement?.querySelector(
            `[data-heading-id="${activeIds[0]}"]`
          ) as HTMLElement | null
          if (firstActive) {
            scrollToActiveItem(scrollArea, firstActive)
          }
        }
      }
    )

    return () => {
      unsubProgress()
      unsubHeadings()
      scrollArea?.removeEventListener("scroll", updateMask)
      detailsElement?.removeEventListener("toggle", handleDetailsToggle)
    }
  }

  initTOCObserver(initHeader)
</script>
