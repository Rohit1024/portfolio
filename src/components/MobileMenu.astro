---
import { Button } from "@/components/starwind/button"
import {
  Dropdown,
  DropdownContent,
  DropdownLinkItem,
  DropdownTrigger,
} from "@/components/starwind/dropdown"
import { NAV_LINKS } from "@/consts"
import { Icon } from "astro-icon/components"
---

<Dropdown>
  <DropdownTrigger asChild>
    <Button
      variant="ghost"
      size="icon-sm"
      class="size-8 sm:hidden"
      aria-label="Toggle menu"
      title="Menu"
    >
      <Icon name="lucide:menu" class="size-5" />
      <span class="sr-only">Toggle menu</span>
    </Button>
  </DropdownTrigger>
  <DropdownContent align="end" class="bg-background">
    {
      NAV_LINKS.map((item) => (
        <DropdownLinkItem
          href={item.href}
          closeOnClick
          class="w-full text-lg font-medium capitalize"
        >
          {item.label}
        </DropdownLinkItem>
      ))
    }
  </DropdownContent>
</Dropdown>
