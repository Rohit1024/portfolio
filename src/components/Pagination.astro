---
import {
  Pagination as StarwindPagination,
  PaginationContent,
  PaginationEllipsis,
  PaginationItem,
  PaginationLink,
  PaginationNext,
  PaginationPrevious,
} from "@/components/starwind/pagination"

export interface Props {
  currentPage: number
  totalPages: number
  baseUrl: string
  class?: string
}

const { currentPage, totalPages, baseUrl, class: className } = Astro.props

const cleanBaseUrl = baseUrl.replace(/\/+$/, "")

const getPageUrl = (page: number) => {
  // Fallback to prevent invalid routing
  if (page < 1 || page > totalPages) return "#"
  if (page === 1) return cleanBaseUrl || "/"
  return `${cleanBaseUrl}/${page}`
}

type PageItem = number | "ellipsis"

function getPaginationItems(current: number, total: number): PageItem[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1)
  }

  if (current <= 4) {
    return [1, 2, 3, 4, 5, "ellipsis", total]
  }

  if (current >= total - 3) {
    return [1, "ellipsis", total - 4, total - 3, total - 2, total - 1, total]
  }

  return [1, "ellipsis", current - 1, current, current + 1, "ellipsis", total]
}

const items = getPaginationItems(currentPage, totalPages)

// Pre-calculate boundary states for cleaner template markup
const isFirstPage = currentPage <= 1
const isLastPage = currentPage >= totalPages
---

{
  totalPages > 1 && (
    <StarwindPagination class={className}>
      <PaginationContent class="flex-wrap">
        <PaginationItem>
          <PaginationPrevious
            href={isFirstPage ? undefined : getPageUrl(currentPage - 1)}
            disabled={isFirstPage}
            aria-disabled={isFirstPage}
            tabindex={isFirstPage ? -1 : 0}
          />
        </PaginationItem>

        {items.map((item) => (
          <PaginationItem>
            {item === "ellipsis" ? (
              <PaginationEllipsis />
            ) : (
              <PaginationLink
                href={getPageUrl(item)}
                isActive={item === currentPage}
                aria-current={item === currentPage ? "page" : undefined}
              >
                {item}
              </PaginationLink>
            )}
          </PaginationItem>
        ))}

        <PaginationItem>
          <PaginationNext
            href={isLastPage ? undefined : getPageUrl(currentPage + 1)}
            disabled={isLastPage}
            aria-disabled={isLastPage}
            tabindex={isLastPage ? -1 : 0}
          />
        </PaginationItem>
      </PaginationContent>
    </StarwindPagination>
  )
}
