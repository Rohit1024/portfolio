---
import { SITE } from "@/consts"
import { getOgImagePath } from "@alfanjauhari/astro-og-images/path"

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  image?: string
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  image,
} = Astro.props

const isHome = title === SITE.title || title === "Home"
const pageTitle = isHome
  ? `Rohit Kharche | Full-Stack DevOps Engineer`
  : `${title} | ${SITE.title}`
const ogTitle = isHome
  ? `Rohit Kharche | Full-Stack DevOps Engineer Portfolio`
  : title

const ogImageUrl = image
  ? new URL(image, Astro.site).toString()
  : getOgImagePath({
      format: "png",
      site: Astro.site,
      url: Astro.url,
    })
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:alt" content={ogTitle} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={canonicalUrl} />

<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogTitle} />
<meta name="twitter:card" content="summary_large_image" />
