---
import Link from "@/components/Link.astro"
import { Badge } from "@/components/starwind/badge"
import { formatDate } from "@/lib/utils"
import { Icon } from "astro-icon/components"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

interface Props {
  project: CollectionEntry<"projects">
}

const { project } = Astro.props
---

<div
  class="group glow-card relative rounded-xl border border-border/50 bg-card/30 p-4 backdrop-blur-xs transition-all duration-300 ease-out hover:-translate-y-1 hover:border-primary/30 hover:bg-card/50 hover:shadow-xl hover:shadow-primary/5"
>
  <Link
    href={project.data.link}
    class="flex flex-col gap-4 sm:flex-row"
    external
  >
    {
      project.data.image && (
        <div class="h-48 w-full overflow-hidden rounded-lg sm:h-auto sm:w-56 sm:shrink-0 sm:self-stretch">
          <Image
            src={project.data.image}
            alt={project.data.name}
            width={1200}
            height={630}
            class="h-full w-full rounded-lg object-cover grayscale transition-all duration-300 ease-in-out group-hover:grayscale-0"
          />
        </div>
      )
    }
    <div class="flex grow flex-col justify-between">
      <div>
        <h3 class="mb-1 text-lg font-medium">
          {project.data.name}
        </h3>
        <p class="mb-2 line-clamp-2 text-sm text-muted-foreground">
          {project.data.description}
        </p>
        {
          project.data.startDate && (
            <p class="mb-2 flex items-center gap-x-1.5 text-xs text-muted-foreground/70">
              <span class="flex items-center gap-x-1.5">
                <Icon name="lucide:calendar" class="size-3" />
                <span>
                  {formatDate(project.data.startDate)}
                  {project.data.endDate
                    ? ` → ${formatDate(project.data.endDate)}`
                    : " → Present"}
                </span>
              </span>
            </p>
          )
        }
      </div>
      {
        project.data.tags && (
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <Badge variant="secondary" showTechIcon={true} techTag={tag}>
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
