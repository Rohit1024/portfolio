---
import {
  Avatar,
  AvatarFallback,
  AvatarImage,
} from "@/components/starwind/avatar"
import { Badge } from "@/components/starwind/badge"
import { Separator } from "@/components/starwind/separator"
import { SITE } from "@/consts"
import { parseAuthors } from "@/lib/data-utils"
import { formatDate } from "@/lib/utils"
import { Icon } from "astro-icon/components"
import type { CollectionEntry } from "astro:content"
import Link from "./Link.astro"

interface Props {
  entry: CollectionEntry<"notes">
}

const { entry } = Astro.props
const { data } = entry

const formattedDate = formatDate(data.date)
const authors = await parseAuthors([SITE.author])
---

<div
  class="group relative rounded-xl border border-border/50 bg-card/30 p-5 backdrop-blur-xs transition-all duration-300 ease-out hover:-translate-y-1 hover:border-primary/30 hover:bg-card/50 hover:shadow-xl hover:shadow-primary/5"
>
  <Link href={`/notes/${entry.id}`} class="flex flex-col gap-4">
    <div class="grow">
      <div>
        <h3
          class="mb-1 text-lg font-medium transition-colors group-hover:text-primary"
          transition:name={`${entry.id}-title`}
        >
          {data.title}
        </h3>
        {
          data.description && (
            <p class="mb-2 text-sm text-muted-foreground">{data.description}</p>
          )
        }
      </div>

      <div class="mb-2">
        <div
          class="mb-2 flex flex-wrap items-center gap-x-1.5 text-xs text-muted-foreground"
        >
          {
            authors.length > 0 && (
              <>
                {authors.map((author) => (
                  <div class="flex items-center gap-x-1.5">
                    <Avatar class="size-5 rounded-full">
                      <AvatarImage src={author.avatar} alt={author.name} />
                      <AvatarFallback>{author.name[0]}</AvatarFallback>
                    </Avatar>
                    <span>{author.name}</span>
                  </div>
                ))}
                <Separator orientation="vertical" class="h-4!" />
              </>
            )
          }
          <span>{formattedDate}</span>
        </div>

        {
          data.tags && data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {data.tags.map((tag: string) => (
                <Badge variant="secondary" class="flex items-center gap-x-1">
                  <Icon name="lucide:hash" class="size-3" />
                  {tag}
                </Badge>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </Link>
</div>
