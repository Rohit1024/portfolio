---
import "@/styles/starwind.css"
import "@/styles/global.css"
import "@/styles/typography.css"

import Footer from "@/components/Footer.astro"
import Head from "@/components/Head.astro"
import Header from "@/components/Header.astro"
import { SITE } from "@/consts"
import { cn } from "@/lib/utils"

interface Props {
  class?: string
  needsKatex?: boolean
  needsDevicons?: boolean
}

const {
  class: className,
  needsKatex = false,
  needsDevicons = false,
} = Astro.props
---

<!doctype html>
<html class="bg-background text-foreground" lang={SITE.locale}>
  <Head needsKatex={needsKatex} needsDevicons={needsDevicons}>
    <slot name="head" />
  </Head>
  <body>
    <div class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
      <div
        id="header-wrapper"
        class="sticky top-0 z-50 divide-y border-b border-transparent bg-transparent transition-all duration-300 xl:divide-none"
      >
        <Header />
        <slot name="subposts-navigation" />
        <slot name="table-of-contents" />
      </div>
      <main
        class="grow animate-in duration-700 ease-out fade-in slide-in-from-bottom-4"
      >
        <div class={cn("mx-auto flex grow flex-col gap-y-6 px-4", className)}>
          <slot />
        </div>
      </main>
      <Footer />
    </div>

    <script is:inline>
      // Header Scroll Effect
      const headerWrapper = document.getElementById("header-wrapper")
      const handleScroll = () => {
        if (window.scrollY > 20) {
          headerWrapper.classList.add(
            "bg-background/80",
            "backdrop-blur-md",
            "shadow-sm",
            "border-border/50"
          )
          headerWrapper.classList.remove("bg-transparent", "border-transparent")
        } else {
          headerWrapper.classList.remove(
            "bg-background/80",
            "backdrop-blur-md",
            "shadow-sm",
            "border-border/50"
          )
          headerWrapper.classList.add("bg-transparent", "border-transparent")
        }
      }
      window.addEventListener("scroll", handleScroll, { passive: true })
      handleScroll() // Init

      // Glow Card Effect
      document.addEventListener("mousemove", (e) => {
        const cards = document.querySelectorAll(".glow-card")
        for (const card of cards) {
          const rect = card.getBoundingClientRect()
          const x = e.clientX - rect.left
          const y = e.clientY - rect.top
          card.style.setProperty("--mouse-x", `${x}px`)
          card.style.setProperty("--mouse-y", `${y}px`)
        }
      })
    </script>
  </body>
</html>
