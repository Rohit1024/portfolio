---
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import PageHead from "@/components/PageHead.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import AboutContent from "@/content/pages/about.mdx"
import Layout from "@/layouts/Layout.astro"
import { getAllProjects } from "@/lib/data-utils"
import { SOCIAL_LINKS } from "@/consts"
import SocialIcons from "@/components/SocialIcons.astro"

const projects = await getAllProjects()
---

<Layout class="max-w-3xl" needsDevicons={true}>
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: "About", icon: "lucide:info" }]} />

  <section>
    <div class="min-w-full">
      <div
        class="mb-8 flex flex-col overflow-hidden rounded-lg border sm:flex-row"
      >
        <div class="h-48 w-full sm:h-auto sm:w-48 sm:shrink-0">
          <img
            src="https://github.com/rohit1024.png"
            alt="Rohit Kharche"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex flex-col justify-start p-6">
          <div class="mb-4 flex flex-col space-y-1.5">
            <h3 class="text-3xl leading-none font-medium">Rohit Kharche</h3>
            <p class="text-sm text-muted-foreground">
              <span class="font-medium">Software Developer</span>
            </p>
          </div>
          <p class="mb-4 text-sm text-muted-foreground">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim
            ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut
            aliquip ex ea commodo consequat.
          </p>
          <SocialIcons links={SOCIAL_LINKS} />
        </div>
      </div>

      <div class="prose mb-8">
        <AboutContent />
      </div>

      <h2 class="mb-4 text-2xl font-medium">Projects</h2>
      <div class="flex flex-col gap-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Layout>
